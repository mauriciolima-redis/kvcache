# Local runtime settings, loaded by the Makefile and exported to the backend.
# Copy from .env.example. Not tracked by git.

# MODEL_ID=mlx-community/Llama-3.2-3B-Instruct-4bit
MODEL_ID=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit
REDIS_NAME=kvcache-redis
REDIS_IMAGE=redis:8
REDIS_PORT=6379
BACKEND_PORT=8000

# Remotely-managed tunnel token (the long base64 "eyJ..." value, not the tunnel UUID).
# Only required by `make prod`.
CLOUDFLARE_TUNNEL_TOKEN=
